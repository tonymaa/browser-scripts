{
  "manifest_version": 3,
  "name": "Quick Login",
  "version": "0.3",
  "description": "快速登录插件 - Browser Extension 版（可视化配置）",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Quick Login 配置"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/forge.min.js", "config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
